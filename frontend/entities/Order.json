{
  "name": "Order",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "title": "Ve\u00edculo ID"
    },
    "vehicle_name": {
      "type": "string",
      "title": "Nome do Ve\u00edculo"
    },
    "vehicle_image": {
      "type": "string",
      "title": "Imagem do Ve\u00edculo"
    },
    "customer_name": {
      "type": "string",
      "title": "Nome do Cliente"
    },
    "customer_email": {
      "type": "string",
      "title": "Email do Cliente"
    },
    "total_price": {
      "type": "number",
      "title": "Pre\u00e7o Total"
    },
    "payment_method": {
      "type": "string",
      "title": "Forma de Pagamento",
      "enum": [
        "Financiamento",
        "\u00c0 Vista",
        "Cons\u00f3rcio",
        "Leasing"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Pendente",
        "Confirmado",
        "Em Produ\u00e7\u00e3o",
        "Pronto para Entrega",
        "Entregue",
        "Cancelado"
      ],
      "default": "Pendente"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "production_steps": {
      "type": "string",
      "title": "Etapas de Produ\u00e7\u00e3o"
    }
  },
  "required": [
    "vehicle_id",
    "vehicle_name",
    "customer_name",
    "customer_email",
    "total_price"
  ]
}