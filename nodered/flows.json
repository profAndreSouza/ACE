        "name": "logistica",
        "func": "let p = msg.payload;\n\nmsg.measurement = \"logistica\";\n\nmsg.payload = {\n    quantidade: 1,\n    id: String(p.id),\n    tipo: String(p.tipo),\n    destino: String(p.destino),\n    status: String(p.status)\n};\n\nmsg.timestamp = new Date(\n    p.timestamp.replace(\n        /(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})/,\n        \"$1-$2-$3T$4:$5:$6\"\n    )\n);\n\nreturn msg;",
