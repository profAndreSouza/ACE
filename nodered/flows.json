    {
        "id": "a1f821a8ba36fae9",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "producao",
        "func": "let p = msg.payload;\n\nmsg.measurement = \"producao\";\n\nmsg.payload = {\n    quantidade: 1,\n    chassi: String(p.chassi),\n    etapa: String(p.etapa),\n    status: String(p.status)\n};\n\nmsg.timestamp = new Date(\n    p.timestamp.replace(\n        /(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})/,\n        \"$1-$2-$3T$4:$5:$6\"\n    )\n);\n\nreturn msg;",
